[Unit]
Description=Run the FinanceMCP A-share weekly watchlist diagnosis (Asia/Shanghai)

[Timer]
# Friday after the unified daily window and the 21:40 ChatGPT deadline.
# (Measured 555s on 2026-10-23; the monthly timer now fires daily at 22:15 and
# skips inside the cadence unless the as-of is the month's last trading day.)
OnCalendar=Fri *-*-* 21:50:00 Asia/Shanghai
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
