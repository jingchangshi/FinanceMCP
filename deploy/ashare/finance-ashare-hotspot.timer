[Unit]
Description=Run the FinanceMCP A-share hotspot sync and snapshot after the close (Asia/Shanghai)

[Timer]
# Fires after the 18:40 daily run (which syncs that day's bars) and well before
# the 21:45 platform research report, so `ashare_hotspot_*` is READY, not
# NOT_READY. Without this timer the daily report has no fresh hotspot snapshot.
OnCalendar=Mon..Fri *-*-* 19:40:00 Asia/Shanghai
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
