[Unit]
Description=FinanceMCP real-account close-of-day research report and forward record
# goal-1032: hotspot runs after daily instead of at 19:40, so the ordering is
# declared here too — the account research record binds itself to a snapshot
# VERSION, and recording before that version exists would bind nothing.
After=docker.service network-online.target finance-ashare-daily.service finance-ashare-hotspot.service
# No Wants=: the daily unit already queues hotspot through OnSuccess/OnFailure.
# Pulling it in here as well would run a second (network-bound) catalog sync.

[Service]
Type=oneshot
# 21:10 的市场流水线完成后运行：21:40 之前 ChatGPT 读到的账户日报必须已写入。
ExecStart=%h/workspace/FinanceMCP/deploy/ashare/run-account-daily.sh
TimeoutStartSec=900
