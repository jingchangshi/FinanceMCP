[Unit]
Description=Run the FinanceMCP unified A-share V3 daily pipeline after close (Asia/Shanghai)

[Timer]
# Trigger at 19:30 Asia/Shanghai after same-day ETF unit NAV updates converge,
# using the free multi-source router (TDX TCP + Tencent + Eastmoney) with
# bounded retries up to 21:15 CST if an upstream dataset is still pending.
OnCalendar=Mon..Fri *-*-* 19:30:00 Asia/Shanghai
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
