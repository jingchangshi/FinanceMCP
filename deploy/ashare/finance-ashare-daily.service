[Unit]
Description=FinanceMCP unified A-share daily sync, hotspot, account bundle and Feishu push
After=docker.service network-online.target

[Service]
Type=oneshot
Environment="PATH=%h/Software/node/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/workspace/FinanceMCP/deploy/ashare/run-daily-unified.sh
TimeoutStartSec=16200
