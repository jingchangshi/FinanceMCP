[Unit]
Description=Run the account research report after the market pipeline (Asia/Shanghai)

[Timer]
# RETIRED AS STANDALONE TIMER:
# Consolidated into finance-ashare-daily.timer (17:20 CST -> run-daily-unified.sh),
# which invokes run-account-daily.sh immediately after market & hotspot readiness.
# Kept only for manual reference; do not enable alongside finance-ashare-daily.timer.
OnCalendar=Mon..Fri *-*-* 21:15:00 Asia/Shanghai
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
